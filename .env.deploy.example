# ──────────────────────────────────────────────────────────────────────────
# OPS settings for the production host — copy to .env.deploy, then
# `chmod 600 .env.deploy .env.production`. Read by scripts/deploy.sh,
# backup.sh, restore.sh and for docker-compose.prod.yml interpolation. NEVER
# handed to the app containers (their settings live in .env.production).
# Sourced by bash: quote values containing < > | & or spaces.
# ──────────────────────────────────────────────────────────────────────────

# Database password. Hex, because it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# Compose project: scopes containers, volumes and image names. PIN IT — the
# default is "<directory>-prod", so renaming the directory would point at new,
# empty volumes.
DEPLOY_PROJECT=my-app-prod

# Loopback port the tunnel points at (NOT WEB_PORT — that is the dev server).
PROD_WEB_PORT=3280

# Public door (optional): a Cloudflare Tunnel run by the stack itself.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# Deploy knobs (defaults shown).
# DEPLOY_BRANCH=main
# DEPLOY_HEALTH_TIMEOUT=120
# DEPLOY_KEEP_IMAGES=3
# DEPLOY_BUILD_CACHE_MAX=30GB

# Backups (defaults shown). Keep counts must be at least 2.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_PRE=5
# BACKUP_MIN_FREE_MB=2048
# Off-host copy over ssh (key auth). Strongly recommended: a dead disk takes
# local backups with it.
# BACKUP_RSYNC_TARGET=user@nas:/backups/my-app
