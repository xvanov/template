# ──────────────────────────────────────────────────────────────────────────
# Copy to .env and edit. `npm run setup` does this and fills the secret.
# Every variable is validated at boot by packages/env — a missing required
# var fails fast with a readable message instead of a runtime 500.
# ──────────────────────────────────────────────────────────────────────────

# --- identity + ports ---------------------------------------------------
# Compose names containers `<project>-<service>-1` and defaults the project to
# this directory's name. Set it explicitly, and give each app its own ports, and
# two apps generated from this template run side by side on one machine.
#
# Change a *_PORT and you must change the matching URL below it — DATABASE_URL,
# REDIS_URL and SMTP_PORT are what the app actually dials.
#
# COMPOSE_PROJECT_NAME is LEFT UNSET on purpose. Compose defaults it to this
# directory's name, which already isolates one app from another — and *setting*
# it later re-points the stack at differently-named volumes, so a running app
# appears to lose its whole database. Only set it if you know you want that.
# COMPOSE_PROJECT_NAME=
DB_PORT=5442
REDIS_PORT=6389
MAIL_SMTP_PORT=1035
MAIL_UI_PORT=8035
TEST_MAIL_SMTP_PORT=1036
TEST_MAIL_UI_PORT=8036
WEB_PORT=3200

# --- core ---------------------------------------------------------------
# NODE_ENV is deliberately NOT set here: Next.js and the test runners set it
# themselves, and a stale `development` in .env silently poisons production
# builds.

# Public origin of the web app. Also the OAuth callback host and the origin
# the mobile app talks to in a browser-based dev session.
APP_URL=http://localhost:3200

# --- database (docker compose publishes on 127.0.0.1:5442) ---------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/app?schema=public

# --- redis / job queue (docker compose publishes on 127.0.0.1:6389) -----
REDIS_URL=redis://localhost:6389

# --- auth ---------------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3200

# Google OAuth — OPTIONAL. Email+password sign-in works without it.
# To enable: console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application, and add BOTH redirect URIs:
#   http://localhost:3200/api/auth/callback/google
#   <your public https origin>/api/auth/callback/google
# The mobile app reuses this same web client via the deep-link scheme below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to complete an auth round trip, comma-separated. Needed
# when the app is reachable somewhere other than APP_URL — a Cloudflare tunnel,
# a preview deploy, your LAN address for phone testing. Explicit by design: this
# list is a CSRF boundary, so there is no wildcard.
# e.g. TRUSTED_ORIGINS=https://app.example.com,http://10.0.0.5:3200
TRUSTED_ORIGINS=

# Auth rate limiting per IP. Leave enabled everywhere — a password endpoint with
# no limiter is the cheapest attack surface you own. Raise only for load tests.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=100

# --- email confirmation -------------------------------------------------
# Require a confirmed address before a password sign-in works. Leave ON: it is
# the only thing stopping someone signing up as an address they do not own.
REQUIRE_EMAIL_VERIFICATION=true

# SMTP. `docker compose up -d mailpit` runs a REAL local SMTP server and inbox
# (http://localhost:8035) — no third-party account, nothing leaves the machine.
# Unset SMTP_HOST and mail is printed to the console instead, so a fresh clone
# still runs and you can copy the confirmation link out of the terminal.
#
# Mailpit shows mail; it never delivers onward. To reach real inboxes, point
# these at an SMTP relay — self-hosting an MTA strangers accept is a
# deliverability project (SPF/DKIM/DMARC, and port 25 is usually blocked).
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Quoted deliberately: scripts/smoke.sh sources this file with `.`, and an
# unquoted `<` is a shell redirect. dotenv strips the quotes, so both readers
# are happy. Quote any value containing < > | & ( ) or spaces-with-symbols.
SMTP_FROM="App Template <no-reply@localhost>"

# Where the "confirm your email" screen points you in development. Set this
# whenever mail goes to a local catcher instead of the real address — otherwise
# "no email arrived" and "the email is in a different inbox" look identical.
# Use a LAN or tunnel URL if you test from a phone; localhost is not reachable
# from another device. LEAVE UNSET IN PRODUCTION.
DEV_MAIL_INBOX_URL=http://localhost:8035
# Same value, exposed to the mobile bundle (EXPO_PUBLIC_ prefix is required).
EXPO_PUBLIC_DEV_MAIL_INBOX_URL=http://localhost:8035

# Deep-link scheme used by the mobile app for the OAuth round trip.
# Must match `expo.scheme` in apps/mobile/app.json.
APP_SCHEME=apptemplate

# --- LLM (any OpenAI-compatible endpoint: OpenAI, Azure, DeepSeek,
#     OpenRouter, Groq, Ollama, vLLM). Leave LLM_API_KEY empty to run the
#     app with the AI feature disabled rather than crashing. -------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Cost accounting, USD per 1M tokens — used by packages/ai to price each call.
LLM_INPUT_COST_PER_MTOK=0.40
LLM_OUTPUT_COST_PER_MTOK=1.60

# --- file / media storage ----------------------------------------------
# local | s3   (s3 also covers R2, MinIO, B2 — anything S3-compatible)
STORAGE_DRIVER=local
# A RELATIVE path resolves against each process's cwd, which is not the same for
# the web app, the worker and the container. Use an absolute path if you want
# one shared directory. The resolved root is logged at first use.
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The API origin the phone dials. localhost does NOT work from a physical
# device — use your machine's LAN IP (`hostname -I | awk '{print $1}'`) or a
# tunnel hostname. `npm run setup` prints the right value for this machine.
EXPO_PUBLIC_API_URL=http://localhost:3200
