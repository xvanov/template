# dependencies
node_modules/
.pnp
.pnp.js

# build output
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# generated code (regenerated by `npm run db:generate`)
packages/db/generated/

# env — NEVER commit real secrets
.env
.env.*
!.env.example

# local runtime state
#
# LEADING SLASH IS LOAD-BEARING: a bare `storage/` matches a directory of that
# name at ANY depth, which silently excluded `packages/storage` from the repo.
# Everything still worked locally and in `docker build` (both read the working
# directory, not git), so the breakage only appeared in a fresh clone. Anchor
# ignore rules that could collide with a source path.
/storage/
/apps/*/storage/
coverage/
test-results/
playwright-report/
blob-report/
*.log
logs/

# expo / react-native
.expo/
.expo-shared/
apps/mobile/android/
apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
