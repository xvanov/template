# dependencies
node_modules/
.pnp
.pnp.js

# build output
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# generated code (regenerated by `npm run db:generate`)
packages/db/generated/

# env — NEVER commit real secrets
.env
.env.*
!.env.example
!.env.deploy.example

# local runtime state
#
# LEADING SLASH IS LOAD-BEARING: a bare `storage/` matches a directory of that
# name at ANY depth, which silently excluded `packages/storage` from the repo.
# Everything still worked locally and in `docker build` (both read the working
# directory, not git), so the breakage only appeared in a fresh clone. Anchor
# ignore rules that could collide with a source path.
/storage/
/apps/*/storage/
# production state on the deploy host (scripts/deploy.sh, scripts/backup.sh)
/.deploy/
/backups/
coverage/
test-results/
playwright-report/
blob-report/
*.log
logs/

# expo / react-native
.expo/
.expo-shared/
apps/mobile/android/
apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# desktop (apps/desktop): Rust build output and tauri-generated schemas.
# Updater signing keys never belong in the repo (see apps/desktop/README.md).
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/
*.tauri.key
*.tauri.key.pub

# ml/ (the Python sidecar, ml/README.md): environments, run outputs, data and
# model weights never go in git. Commit code, configs, splits/ and experiments/.
/ml/.venv/
/ml/runs/
/ml/models/
/ml/data/*
!/ml/data/README.md
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Competition data and credentials, wherever they land (docs/hackathon.md).
kaggle.json
