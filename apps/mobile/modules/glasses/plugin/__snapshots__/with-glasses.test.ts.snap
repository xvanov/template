exports[`disabled: the module stays out of autolinking Podfile and settings.gradle 1`] = `
"}
// GLASSES_ENABLED is off: keep the glasses module (and Meta's SDK) out.
expoAutolinking.exclude = ["glasses"]
expoAutolinking.useExpoModules()

rootProject.name = 'App Template'
"
`;

