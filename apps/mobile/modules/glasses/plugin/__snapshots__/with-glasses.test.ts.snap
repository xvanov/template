exports[`enabled: iOS Info.plist 1`] = `
{
  "MWDAT": {
    "Analytics": {
      "OptOut": true,
    },
    "AppLinkURLScheme": "apptemplate://",
    "ClientToken": "0",
    "MetaAppID": "0",
    "TeamID": "$(DEVELOPMENT_TEAM)",
  },
  "NSBluetoothAlwaysUsageDescription": "App Template connects to your Meta AI glasses over Bluetooth.",
  "NSBonjourServices": [
    "_expo._tcp",
    "_bonjour._tcp",
  ],
  "NSCameraUsageDescription": "Existing camera text.",
  "NSLocalNetworkUsageDescription": "App Template finds and connects to your glasses over Wi-Fi.",
  "UIBackgroundModes": [
    "remote-notification",
    "bluetooth-central",
    "bluetooth-peripheral",
    "external-accessory",
    "processing",
  ],
  "UISupportedExternalAccessoryProtocols": [
    "com.meta.ar.wearable",
  ],
}
`;

