// ─────────────────────────────────────────────────────────────────────────
// Prisma schema.
//
// Two groups of models:
//   1. AUTH — owned by better-auth. Do NOT hand-edit field names; they are
//      part of better-auth's contract. Regenerate with `npm run auth:schema`
//      after changing plugins in packages/auth, then `npm run db:migrate`.
//   2. APP — yours. Every app model carries `orgId` and is queried through
//      the org-scoped tRPC procedures (see packages/api/src/trpc.ts), so a
//      tenant can never read another tenant's rows.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider            = "prisma-client"
  output              = "../generated"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── AUTH (better-auth) ──────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  members        Member[]
  invitations    Invitation[]
  items          Item[]
  mediaAssets    MediaAsset[]
  agentRuns      AgentRun[]
  apiKeys        ApiKey[]
  reviewed       AgentProposal[]  @relation("ProposalReviewer")
  proposed       AgentProposal[]  @relation("ProposalProposer")
  documents      Document[]
  handledInbound InboundMessage[]
  pushDevices    PushDevice[]
  glanceLinks    GlanceLink[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Written by the better-auth organization plugin: the tenant this session
  // is currently acting in. Every org-scoped query keys off it.
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────── MULTI-TENANCY (organization plugin) ───────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Required + unique: better-auth's organization plugin treats the slug as the
  // tenant's public handle and will not accept a null.
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  items         Item[]
  mediaAssets   MediaAsset[]
  jobRuns       JobRun[]
  auditEvents   AuditEvent[]
  outbound      OutboundMessage[]
  suppressed    OutboundSuppression[]
  agentRuns     AgentRun[]
  agentSteps    AgentStep[]
  proposals     AgentProposal[]
  apiKeys       ApiKey[]
  documents     Document[]
  docChunks     DocumentChunk[]
  inbound       InboundMessage[]
  inboundRoutes InboundRoute[]
  pushDevices   PushDevice[]
  glanceLinks   GlanceLink[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ────────────────────────────── APP MODELS ───────────────────────────────

/// The demo domain object. Replace with your own — but keep the `orgId`
/// column and the `@@index([organizationId, createdAt])` shape.
model Item {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  done           Boolean      @default(false)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@map("item")
}

/// One app install that can receive mobile push (Expo push token), registered
/// by the signed-in user under their ACTIVE organization (push.register).
///
/// A token names one install, so it is unique: whoever registers it last owns
/// it (a phone that changed hands, or a user who switched org, moves the row;
/// see packages/api/src/routers/push.ts). `disabled` is set when Expo reports
/// DeviceNotRegistered (the app was uninstalled), or on sign-out; the sender
/// skips disabled rows and a fresh registration re-enables it.
model PushDevice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `ExponentPushToken[...]`. Case-sensitive. A bearer capability for the
  /// device: never shown to other users, never logged in full.
  token          String       @unique
  /// ios | android
  platform       String
  disabled       Boolean      @default(false)
  /// Why it was disabled: "DeviceNotRegistered", "signed out", ...
  disabledReason String?
  /// Last registration (every app start while signed in).
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@map("push_device")
}

/// A read-only link for a glanceable view (/glance/<secret>), e.g. a web app
/// on Meta Ray-Ban Display glasses, where signing in is impractical. Acts as
/// its creator in its organization, ONLY for the glance snapshot; stops
/// working when revoked or when the creator leaves the organization.
model GlanceLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// The first characters of the secret, to tell links apart in a list.
  prefix         String
  /// SHA-256 of the secret (`gl_` + 256 random bits); the secret is shown once.
  hash           String       @unique
  /// False (default): counts only ("3 waiting"), never who or what. True:
  /// also titles and senders, which then show on a see-through display.
  showDetails    Boolean      @default(false)
  /// Refused after this (null = never; the UI defaults to 30 days).
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
  @@map("glance_link")
}

/// A blob in packages/storage. The row is the source of truth for metadata;
/// `key` is the driver-agnostic object key.
model MediaAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       @unique
  filename       String
  contentType    String
  sizeBytes      Int
  /// Null for files nobody uploaded through the app: attachments of inbound
  /// messages (packages/inbound) arrive from outside.
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  documents      Document[]

  @@index([organizationId, createdAt])
  @@map("media_asset")
}

/// A searchable document (packages/rag): text the tenant uploaded, or a
/// text-like file in storage. Indexed into document_chunk by the
/// `docs.ingest` job; re-ingesting unchanged content is a no-op (contentHash).
model Document {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  /// upload | media
  source         String
  /// The storage file this came from (source = media). Deleting the file keeps the document.
  mediaAssetId   String?
  mediaAsset     MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  contentType    String          @default("text/markdown")
  /// The full text. Chunks are derived from it and can always be rebuilt.
  content        String
  /// sha256 of the content AND the chunker version: what an ingest compares.
  contentHash    String
  /// pending | indexing | ready | failed
  status         String          @default("pending")
  /// The hash the current chunks were built from (null = never indexed).
  indexedHash    String?
  chunkCount     Int             @default(0)
  /// Chunks with an embedding; < chunkCount means search is keyword-only for the rest.
  embeddedCount  Int             @default(0)
  /// `provider/model` the embeddings came from, or null.
  embeddingModel String?
  /// Why the last ingest failed, or why it is keyword-only (embeddings off).
  note           String?
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  indexedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chunks         DocumentChunk[]

  @@index([organizationId, createdAt])
  @@index([organizationId, mediaAssetId])
  @@map("document")
}

/// One retrievable piece of a Document. `embedding` and `tsv` are not
/// readable through Prisma (pgvector / tsvector): every query on them is raw
/// SQL in packages/rag/src/store.ts, tenant-scoped like everything else.
model DocumentChunk {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Position in the document, from 0.
  ord            Int
  /// The heading path this chunk sits under ("Setup > Ports"), or "".
  heading        String                       @default("")
  content        String
  /// sha256 of heading + content: an unchanged chunk keeps its embedding on re-ingest.
  contentHash    String
  /// vector(1536): LLM_EMBEDDING_DIMENSIONS must match. Null = not embedded.
  embedding      Unsupported("vector(1536)")?
  /// GENERATED ALWAYS from heading (weight A) + content (weight B), english.
  /// The dbgenerated() text is what Postgres reports back for the generation
  /// expression; it keeps `migrate dev` from seeing drift. Never written.
  tsv            Unsupported("tsvector")?     @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, heading), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, content), 'B'::\"char\"))"))
  createdAt      DateTime                     @default(now())

  @@unique([documentId, ord])
  @@index([organizationId, documentId])
  @@index([tsv], type: Gin)
  /// HNSW (vector_cosine_ops) in the migration; Prisma cannot say "hnsw" but
  /// declaring the index by name stops `migrate dev` from dropping it.
  @@index([embedding], map: "document_chunk_embedding_hnsw_idx")
  @@map("document_chunk")
}

/// Every LLM call, priced. This is the seam that makes spend auditable per
/// org and per feature instead of a single opaque provider invoice.
model LlmCall {
  id               String   @id @default(cuid())
  organizationId   String?
  userId           String?
  purpose          String
  /// The model string as routed: `anthropic/claude-opus-5-5`, `local/gpt-4.1-mini`.
  model            String
  /// anthropic | openai | azure | openrouter | deepseek | local | cli
  provider         String?
  /// The named tier the caller asked for (fast | default | smart), if any.
  tier             String?
  /// essential | discretionary — what the daily cap does with it.
  priority         String?
  /// "chat", "embed" or "transcribe".
  kind             String   @default("chat")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  /// False when the real cost is not known: no price is configured, or the
  /// call died mid-flight (timeout, dropped stream). costUsd then holds the
  /// pre-send estimate (0 for an unpriced model), so it still counts against
  /// the cap — and the day's total is a floor, not a fact.
  costKnown        Boolean  @default(true)
  latencyMs        Int      @default(0)
  ok               Boolean  @default(true)
  error            String?
  /// "pending" from the moment the cap reserved this call (costUsd = the
  /// estimate) until it settles to "done". Pending rows count against the cap,
  /// so concurrent calls cannot all slip under it. A pending row older than any
  /// call can run is marked "abandoned" (and keeps counting its estimate).
  status           String   @default("done")
  createdAt        DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([purpose, createdAt])
  @@map("llm_call")
}

/// Background-job observability. The queue is Redis (ephemeral); this table
/// is the durable record of what ran, so a job that vanishes is visible.
///
/// `organizationId` is the tenant the job ran FOR, taken from the payload's
/// `organizationId`. Null means a system job (maintenance, fan-out schedules)
/// that belongs to no tenant; those are never shown to a tenant.
model JobRun {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  name           String
  status         String        @default("queued")
  attempts       Int           @default(0)
  payload        String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([name, createdAt])
  @@index([status])
  @@map("job_run")
}

/// Who did what to which thing, in which tenant. Append-only: nothing in the
/// app updates or deletes a row (an org's rows go when the org does).
///
/// Write through `ctx.audit(...)` in packages/api (it fills actor, org, ip and
/// user agent), or `recordAudit` from @repo/db outside a request.
model AuditEvent {
  id             String        @id @default(cuid())
  /// Null only for genuinely global actions; those are never shown to a tenant.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "user" | "system" | "job"
  actorType      String        @default("user")
  /// User id, job name, ... depending on actorType.
  actorId        String?
  /// Dotted verb: `item.create`, `item.delete`, `member.invite`.
  action         String
  targetType     String
  targetId       String?
  /// Anything worth keeping: the changed fields, the before/after, the reason.
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_event")
}

/// Every outbound message ATTEMPT (email, push, sms), sent or not.
/// Written by packages/outbound before the provider is called, so a message
/// cannot leave without a row; blocked attempts carry the gate that stopped them.
///
/// Null organizationId = system mail (sign-up verification, which happens
/// before the account has an org); never shown to a tenant.
model OutboundMessage {
  id                String           @id @default(cuid())
  organizationId    String?
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "email" | "sms" | "push" | "mobile_push"
  channel           String
  recipient         String
  subject           String?
  /// What sent it: `auth.verify-email`, `items.digest`. Grep-able.
  purpose           String
  /// "pending" (provider being called) | "sent" | "failed" | "blocked"
  status            String
  /// Which gate stopped it (SAFE_MODE, FROZEN, VOLUME, ...) when blocked.
  blockReason       String?
  /// Human-readable why, or the provider error when failed.
  detail            String?
  providerMessageId String?
  actorUserId       String?
  /// The caller's key for "this one logical message" (e.g. `invoice.42.reminder`).
  /// Unique per tenant (`idempotencyScope`): a retry with the same key reuses
  /// this row and never sends twice once sent.
  idempotencyKey    String?
  /// The tenant id, or "system" for rows with no tenant: the key's namespace.
  /// A column rather than organizationId itself because Postgres treats NULLs
  /// as distinct, and system keys must collide too.
  idempotencyScope  String?
  /// When a sender last took this row to send ("pending" since then). A
  /// pending row claimed longer ago than the in-flight window is abandoned.
  claimedAt         DateTime?
  /// What the provider reported AFTER accepting it (webhooks, the SMS
  /// reconcile job): "queued" | "sent" | "delayed" | "delivered" | "bounced"
  /// | "undelivered" | "failed" | "complained" | "suppressed". `status` above
  /// stays the guard's own verdict; this is the recipient side.
  deliveryStatus    String?
  /// The provider's reason (bounce message, Twilio error code explained).
  deliveryDetail    String?
  deliveryUpdatedAt DateTime?
  createdAt         DateTime         @default(now())
  finishedAt        DateTime?
  repliesReceived   InboundMessage[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
  @@index([channel, providerMessageId])
  @@map("outbound_message")
}

/// Recipients who must not be messaged: bounces, complaints, unsubscribes.
/// Null organizationId = suppressed everywhere (a hard bounce); otherwise only
/// for that tenant's messages (an unsubscribe from one workspace).
model OutboundSuppression {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String
  /// Normalised the same way the guard normalises (lowercased email, E.164).
  recipient      String
  reason         String
  createdAt      DateTime      @default(now())

  @@unique([channel, recipient, organizationId])
  @@index([channel, recipient])
  @@map("outbound_suppression")
}

/// A message that ARRIVED (packages/inbound): an email to one of the org's
/// inbound addresses, or an SMS to the app's number. Org-scoped: written only
/// once the recipient address routed to a tenant (see InboundRoute).
///
/// The webhook stores the row ("received") and the worker fills in the rest
/// ("processed"): body, attachments (to packages/storage), the thread link.
model InboundMessage {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "email" | "sms"
  channel           String
  /// "resend" | "generic" | "twilio": who delivered it to us.
  provider          String
  /// The provider's id for it; with `provider`, the dedupe key (webhooks retry).
  providerMessageId String
  fromAddress       String
  /// The address it was sent to that routed it here.
  toAddress         String
  subject           String?
  /// The first ~200 characters of `text`, for the inbox list.
  snippet           String?
  text              String?
  /// Stored as received and NEVER rendered as HTML by the app (stored XSS):
  /// the UI shows `text`, which the worker derives from this when absent.
  html              String?
  /// RFC 5322 Message-ID / In-Reply-To / References, for threading.
  messageIdHeader   String?
  inReplyTo         String?
  /// [{ filename, contentType, sizeBytes, mediaAssetId | null, skipped? }]
  attachments       Json             @default("[]")
  /// The outbound message this answers, when it could be matched
  /// (In-Reply-To/References for email; the last text to that number for SMS).
  replyToOutboundId String?
  replyToOutbound   OutboundMessage? @relation(fields: [replyToOutboundId], references: [id], onDelete: SetNull)
  /// "received" (waiting for the worker) | "processed" | "failed"
  status            String           @default("received")
  error             String?
  /// What the provider sent, until the worker has processed it (then cleared).
  raw               Json?
  handledAt         DateTime?
  handledById       String?
  handledBy         User?            @relation(fields: [handledById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  processedAt       DateTime?

  @@unique([provider, providerMessageId])
  @@index([organizationId, createdAt])
  @@index([organizationId, handledAt])
  @@map("inbound_message")
}

/// Which tenant an inbound address belongs to. `address` is normalised the
/// way the outbound guard normalises (lowercased email, E.164 number), and
/// unique across the app: one address, one tenant.
model InboundRoute {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "email" | "sms"
  channel        String
  address        String
  /// Set (to organizationId) only on the address the app generated for the
  /// tenant: unique, so a tenant has at most one, however many requests race.
  /// Null on addresses added by hand (NULLs do not collide).
  autoForOrg     String?      @unique
  createdAt      DateTime     @default(now())

  @@unique([channel, address])
  @@index([organizationId])
  @@map("inbound_route")
}

/// Operator notifications (packages/notify): alerts for whoever RUNS the app,
/// never shown to a tenant. Every call to notifyOperator writes one row, sent
/// or not; the send itself is also an outbound_message row (outboundMessageId).
///
/// organizationId is context ("which tenant hit the AI cap"), deliberately NOT
/// a foreign key: the operator's history must survive the tenant's deletion.
model Notification {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  /// "low" | "normal" | "high" | "urgent"
  priority          String
  title             String
  body              String
  url               String?
  tags              String[]
  /// Same key within the dedupe window = recorded as "deduped", not sent.
  dedupeKey         String?
  /// Where it went (or would go): "push" | "email" | "console".
  channel           String
  /// "pending" | "sent" | "logged" (console) | "held" (waiting for the digest)
  /// | "digested" | "deduped" | "blocked" | "failed"
  status            String
  /// Why it was held/blocked, or the send error.
  error             String?
  organizationId    String?
  /// The digest notification that carried this held one.
  digestId          String?
  outboundMessageId String?
  /// When a sender last took it to send ("pending" since then). A pending row
  /// claimed longer ago than the in-flight window is abandoned (crash).
  claimedAt         DateTime?
  sentAt            DateTime?

  @@index([dedupeKey, createdAt])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}

/// Small runtime switches that must survive a Redis restart and be shared by
/// every process: the outbound kill switch (`outbound.freeze`) and the last
/// operator digest slot (`notify.digest.lastSlot`) live here.
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

// ─────────────────────── AGENTS, PROPOSALS, API KEYS ─────────────────────

/// One agent run (packages/agent): a goal, worked on by a model with tools,
/// in the worker. The trace is its `steps`; anything it wanted to CHANGE is an
/// AgentProposal waiting for a human.
model AgentRun {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Who started it (null once that user is deleted).
  createdById       String?
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  goal              String
  /// "queued" | "running" | "completed" | "failed" | "cancelled"
  status            String       @default("queued")
  /// Why it stopped: "done" | "max_steps" | "max_cost" | "cancelled" |
  /// "refusal" | "truncated" | "disabled" | "over_budget" | "forbidden" | "error"
  stopReason        String?
  /// `provider/model` that ran it.
  model             String?
  /// The model's final answer (completed runs).
  result            String?
  /// One line for a human (failed runs).
  error             String?
  /// Model turns taken, and their summed cost (also in llm_call, purpose agent.run).
  turns             Int          @default(0)
  costUsd           Float        @default(0)
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime     @default(now())

  steps     AgentStep[]
  proposals AgentProposal[]

  @@index([organizationId, createdAt])
  /// desktop.feed: "runs in this tenant that finished since the cursor".
  @@index([organizationId, finishedAt])
  @@index([status, createdAt])
  @@map("agent_run")
}

/// The trace: one row per thing that happened in a run, in order.
model AgentStep {
  id             String       @id @default(cuid())
  runId          String
  run            AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Denormalised from the run so every read can pin the tenant in its `where`.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  index          Int
  /// "model" | "tool_call" | "tool_result" | "proposal"
  kind           String
  /// What the step was: the model's text and tool calls, a tool's input or output.
  payload        Json
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  costUsd        Float        @default(0)
  createdAt      DateTime     @default(now())

  @@unique([runId, index])
  @@index([organizationId, createdAt])
  @@map("agent_step")
}

/// A change an agent (or an MCP client without write access) wants to make,
/// waiting for a human: pending → applied | failed (approved), or rejected.
/// Decided ONCE: every transition is an updateMany with the status in the where.
model AgentProposal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null for a proposal that came from MCP rather than a run.
  runId          String?
  run            AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Who asked: "agent" (a run), "mcp" (an API key without write access),
  /// "user" (agent.propose from a signed-in session)
  source         String       @default("agent")
  /// The user the proposal was made for: the run's starter, or the key's creator.
  proposedById   String?
  proposedBy     User?        @relation("ProposalProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  /// The API key that proposed it (source "mcp").
  apiKeyId       String?
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  /// The write tool's name, e.g. `items_create`.
  tool           String
  /// The input as proposed (validated against the tool's schema).
  input          Json
  /// The input as the reviewer edited it, re-validated; what was applied.
  editedInput    Json?
  /// One line for the queue: what applying it would do, built from the
  /// DATABASE at proposal time (e.g. the real item title), never from the
  /// model's free text.
  summary        String
  /// The proposer's own words (e.g. a delete's "reason"): an unverified claim,
  /// shown to the reviewer as such.
  claim          String?
  /// "pending" | "applied" | "failed" | "rejected"
  status         String       @default("pending")
  reviewerId     String?
  reviewer       User?        @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  /// What apply returned (applied), or why it could not (failed).
  result         Json?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status, createdAt])
  @@index([runId])
  @@map("agent_proposal")
}

/// A per-organization API key for machine callers (the MCP endpoint). Only the
/// SHA-256 of the secret is stored; the secret is shown once, at creation.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The key acts as this member: if they leave the org, the key stops working.
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name           String
  /// The first characters of the secret, to tell keys apart in a list.
  prefix         String
  hash           String       @unique
  /// False: write tools queue a proposal. True: they act directly — but only
  /// while the creator is still an owner/admin (checked on every request).
  canWrite       Boolean      @default(false)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  proposals AgentProposal[]

  @@index([organizationId, createdAt])
  @@map("api_key")
}
