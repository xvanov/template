{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "COMPOSE_PROJECT_NAME",
    "WEB_PORT",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "TEST_REDIS_URL",
    "REDIS_URL",
    "WORKER_CONCURRENCY",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TRUSTED_ORIGINS",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS",
    "AUTH_RATE_LIMIT_MAX",
    "REQUIRE_EMAIL_VERIFICATION",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "DEV_MAIL_INBOX_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL",
    "LLM_INPUT_COST_PER_MTOK",
    "LLM_OUTPUT_COST_PER_MTOK",
    "LLM_ENABLED",
    "LLM_MODEL_FAST",
    "LLM_MODEL_SMART",
    "LLM_EMBEDDING_MODEL",
    "LLM_EFFORT",
    "LLM_DAILY_CAP_USD",
    "LLM_PRICES",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "AZURE_OPENAI_ENDPOINT",
    "AZURE_OPENAI_API_KEY",
    "AZURE_OPENAI_API_VERSION",
    "OPENROUTER_API_KEY",
    "DEEPSEEK_API_KEY",
    "CLAUDE_BIN",
    "CLAUDE_CLI_TIMEOUT_SECONDS",
    "CLAUDE_BRIDGE_URL",
    "CLAUDE_BRIDGE_KEY",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_DIR",
    "APP_VERSION",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "OUTBOUND_SAFE_MODE",
    "OUTBOUND_SAFE_RECIPIENTS",
    "OUTBOUND_EMAIL_ENABLED",
    "OUTBOUND_FROZEN",
    "OUTBOUND_PUSH_ENABLED",
    "NTFY_URL",
    "NTFY_TOPIC",
    "NTFY_TOKEN",
    "OPERATOR_EMAIL",
    "NOTIFY_DEDUPE_WINDOW_MINUTES",
    "NOTIFY_DIGEST_TIMES",
    "OUTBOUND_CAP_RECIPIENT_PER_HOUR",
    "OUTBOUND_CAP_ORG_PER_HOUR",
    "OUTBOUND_CAP_ORG_PER_DAY",
    "OUTBOUND_CAP_GLOBAL_PER_HOUR",
    "CRON_SECRET",
    "EMAIL_WEBHOOK_SECRET",
    "SECRETS_ENCRYPTION_KEY",
    "SECRETS_ENCRYPTION_OLD_KEYS",
    "EXPO_PUBLIC_API_URL",
    "APP_SCHEME",
    "APP_LOCALE",
    "APP_CURRENCY",
    "APP_TIMEZONE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "//#db:generate"],
      "outputs": ["coverage/**"]
    },
    "//#db:generate": {
      "inputs": ["packages/db/prisma/schema.prisma"],
      "outputs": ["packages/db/generated/**"]
    }
  }
}
