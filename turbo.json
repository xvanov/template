{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "COMPOSE_PROJECT_NAME",
    "WEB_PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TRUSTED_ORIGINS",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS",
    "AUTH_RATE_LIMIT_MAX",
    "REQUIRE_EMAIL_VERIFICATION",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "DEV_MAIL_INBOX_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_DIR",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "EXPO_PUBLIC_API_URL",
    "APP_SCHEME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "//#db:generate"],
      "outputs": ["coverage/**"]
    },
    "//#db:generate": {
      "inputs": ["packages/db/prisma/schema.prisma"],
      "outputs": ["packages/db/generated/**"]
    }
  }
}
